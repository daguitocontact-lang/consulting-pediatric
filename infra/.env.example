# Copy to infra/.env (gitignored) and adjust. Read by docker-compose.dev.yml
# both for interpolation and as the api/panel env_file.

# ── Your dev slug ────────────────────────────────────────────────────
# Drives the per-developer tunnel hostnames created by
# scripts/dev/setup-tunnels.sh: pediatric-api-<user>.daguito.com and
# pediatric-panel-<user>.daguito.com.
PEDIATRIC_TUNNEL_USER=

# ── Ports (4100s / 5442 so a Daguito dev stack can run alongside) ────
API_PORT=4101
PANEL_PORT=4102
POSTGRES_PORT=5442

# ── Postgres (compose) ───────────────────────────────────────────────
POSTGRES_USER=pediatric_app
POSTGRES_PASSWORD=pediatric
POSTGRES_DB=pediatric

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated in dev: the local Daguito web, its tunnel, and the panel's own
# origin (handy when opening the panel standalone). Prod passes exactly one.
# localhost:4102 is the panel dev harness (apps/panel/index.html) calling the API.
ALLOWED_ORIGIN=http://localhost:4000,http://localhost:4102,https://app-dev3.daguito.com

# ── Daguito's RS256 public key ───────────────────────────────────────
# PEM, or base64 of the PEM (env files can't carry newlines — auth.ts accepts
# both). Leave empty and run the minter to get a self-contained local keypair:
#
#   cd apps/api && bun scripts/dev/mint-token.ts
#
# It writes the public key here and prints a token you can use as a Bearer.
# To test against Daguito's real dev tokens instead, paste the public key from
# SSM /daguito/prod/api/AUTH_JWT_PUBLIC_KEY (base64 it first).
DAGUITO_JWT_PUBLIC_KEY=

# ── Tenant allow-list ────────────────────────────────────────────────
# Comma-separated Daguito org ids this custom serves. REQUIRED — the API
# refuses to boot without it. Daguito signs `custom-panel` tokens for every org
# it hosts with the same key, so this is what stops another org's valid token
# from reading this client's data. In dev it must match the org you mint tokens
# for (mint-token.ts defaults to org_dev).
DAGUITO_ORG_IDS=org_dev

# ── Daguito API (outbound) ───────────────────────────────────────────
# How this API calls Daguito's to register the contact's custom fields on boot
# (src/daguito). The credential is an ACCOUNT KEY, not a login: an org owner
# mints it in Daguito (POST /v1/account/api-keys) and can revoke it there, and
# it is bound to exactly one org.
#
# Empty = the registration is skipped and the API boots anyway. Unlike
# DAGUITO_ORG_IDS this is not fail-closed: it guards no data, it only creates
# form fields.
DAGUITO_API_BASE=http://host.docker.internal:4001
DAGUITO_API_KEY=

# ── Documents (passenger ID scans) ───────────────────────────────────
# Prod keeps them in a PRIVATE R2 bucket the API alone can reach. Leave these
# empty in dev and the same code writes to STORAGE_DIR instead (a folder in the
# api container, gitignored) — no second bucket per developer.
#
# To test against the real bucket: an R2 API token with Object Read & Write on
# pediatric-docs (Cloudflare dashboard → R2 → Manage API tokens).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_DIR=.storage

# ── Daguito webhooks (inbound) ───────────────────────────────────────
# Secret of the `pediatric-ticket-resolved` subscription, shown ONCE when the
# subscription is created (migration 20260902_030000 in Daguito, or Ajustes →
# Webhooks). The API verifies `x-daguito-signature` against it; without it the
# receiver answers 503 and never writes a reservation.
DAGUITO_WEBHOOK_SECRET=

# ── Motor de transcripción / IA (flows de Daguito) ───────────────────
# La IA de la consulta NO vive aquí: son flows de Daguito
# (realtime-consultation, in-person-consultation, pre-recorded-consultation).
# La API resuelve el flow por slug con esta llave, abre la sesión y acuña un
# token corto por consulta; el navegador habla directo con Daguito.
# Vacías = la pantalla funciona sin motor (sala, nota a mano, hilo guardado) y
# el badge dice "Sin motor de transcripción".
# La MISMA llave sirve para el asistente del chat: es el flow-agente
# `consultation-chatbot` de la misma cuenta. Sin ella el chat guarda el mensaje
# y responde `assistant_available: false` — la pregunta queda en el registro,
# nadie contesta.
DAGUITO_STREAM_API_URL=https://api.daguito.com
DAGUITO_STREAM_API_KEY=

# ── Jitsi (la sala de video de cada consulta) ────────────────────────
# El dominio del servidor Jitsi. PONLO: es el mismo self-hosted que usa el
# producto legacy y no pide token (su .env no tiene ninguna variable JITSI_).
#
# Dejarlo vacío cae a meet.jit.si, el público, y ahí la consulta NO abre: mete a
# todo el mundo como invitado en la sala de espera ("The conference has not yet
# started because no moderators have yet arrived"), porque solo reconoce como
# moderador a una cuenta de 8x8. El médico se queda mirando el spinner.
JITSI_DOMAIN=meet.midulabs.com
# Credenciales del módulo JWT de Jitsi (prosody token_verification). Vacías = la
# sala es PÚBLICA: quien sepa el nombre entra. Por eso el nombre de sala es
# aleatorio y no se deriva del id de la consulta (migración 0004). No es
# fail-closed: sin credenciales la sala abre igual, porque protege una
# videollamada, no los datos del cliente — esos siguen detrás de requireOrg.
JITSI_APP_ID=
JITSI_APP_SECRET=

# ── Panel dev server ─────────────────────────────────────────────────
# Set to your tunnel hostname so Vite serves correct asset/HMR URLs through it.
# Leave empty for plain http://localhost:4102.
#
# La API TAMBIÉN lo lee (lib/panel-origin.ts): de ahí sale el enlace del paciente
# y el origen que se permite en CORS. Sin él el enlace apunta al host de prod
# (pediatric-panel.daguito.com), que hasta el primer `terraform apply` ni siquiera
# resuelve — el papá ve DNS_PROBE_FINISHED_NXDOMAIN con la API andando perfecto.
PANEL_PUBLIC_HOST=

# Override explícito del host del panel, si por algo no coincide con el de
# arriba. Manda sobre PANEL_PUBLIC_HOST y mueve a la vez el enlace del paciente
# y la allow-list de CORS, para que no puedan apuntar a hosts distintos.
PANEL_BASE_URL=

# La URL COMPLETA de la página del paciente, cuando NO la servimos nosotros.
#
# Vacío = `<PANEL_BASE_URL>/consulta`, al lado del bundle y en nuestro bucket
# (una RUTA, no un .html: el deploy sube los mismos bytes con esa key). Con
# valor, el enlace que copia el médico apunta ahí — la ruta que Daguito exponga
# bajo su dominio, p. ej. https://app.daguito.com/consulta — y ese origen entra
# solo en la allow-list de CORS.
#
# Puede llevar {id} si la ruta de Daguito ES la consulta
# (https://app.daguito.com/consulta/{id}). Ahí el id queda en el log de acceso
# de Daguito; sin {id} viaja solo en el fragmento.
#
# Al ponerlo, el enlace pasa a llevar también `&api=` y `&panel=` en el
# fragmento: en app.daguito.com la página ya no puede deducir ni a qué API
# llamar ni dónde está panel.js. Solo acepta valores bajo daguito.com.
PATIENT_BASE_URL=

# La base pública de ESTA API, si el Host que llega no es el que el paciente
# tiene que llamar (un proxy que lo reescribe). Normalmente vacío: se toma del
# request, y cloudflared pasa el Host original tal cual.
API_BASE_URL=
